# --- Assignment default: local Ollama (required for the take-home) ---
# Sentiment classification MUST work with a locally hosted Ollama model.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Classifier provider: ollama | openai | ai-gateway
# Leave unset locally so Ollama remains the default (assignment).
# On Vercel, if OPENAI_API_KEY or AI_GATEWAY_API_KEY is set, the app
# automatically uses the OpenAI-compatible path even when this is empty.
# CLASSIFIER_PROVIDER=openai

# Optional cloud classifier (OpenAI-compatible: OpenAI, Groq, Azure, AI Gateway).
# Uncomment and set real values — never commit secrets.
# Production Daily Check on Vercel stays disabled until a key is set.
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
# Optional. Defaults to https://api.openai.com/v1, or AI Gateway when
# CLASSIFIER_PROVIDER=ai-gateway / only AI_GATEWAY_API_KEY is set.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Cloud model id. Defaults: gpt-4.1-mini (OpenAI) or openai/gpt-4.1-mini (gateway).
# CLASSIFIER_MODEL=gpt-4.1-mini

# Optional: POST JSON when the daily job finds new mentions.
# Slack incoming webhooks work (the job sends { text, blocks }).
# ALERT_WEBHOOK_URL=

# Collection knobs
MAX_ARTICLES_PER_COMPANY=5
COLLECT_CONCURRENCY=5
CLASSIFY_BATCH_SIZE=3
