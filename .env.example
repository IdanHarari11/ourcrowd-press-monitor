# Local Ollama endpoint (required for sentiment classification)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: POST a JSON payload when the daily job finds new mentions.
# Slack incoming webhooks work (the job sends { text, blocks }).
ALERT_WEBHOOK_URL=

# Collection knobs
MAX_ARTICLES_PER_COMPANY=5
COLLECT_CONCURRENCY=5
CLASSIFY_BATCH_SIZE=3
